
from datetime import date, datetime, time

from peewee import DoesNotExist

from datos.conexion import database
from datos.modelos.models import (
    Reserva,
    Mesa,
    Disponibilidad,
    ClienteDB,
    UsuarioDB,
)


class ReservaRepositorio:
    """Gestiona las operaciones de reservas en MySQL."""

    ESTADOS_VALIDOS = {
        "Pendiente",
        "Confirmada",
        "Cancelada",
        "Completada",
    }

    TRANSICIONES_PERMITIDAS = {
        "Pendiente": {"Confirmada", "Cancelada"},
        "Confirmada": {"Cancelada", "Completada"},
        "Cancelada": set(),
        "Completada": set(),
    }

    @staticmethod
    def _convertir_fecha(valor):
        """Convierte una fecha ISO a date."""
        if isinstance(valor, datetime):
            return valor.date()

        if isinstance(valor, date):
            return valor

        if isinstance(valor, str):
            return date.fromisoformat(valor)

        raise ValueError("La fecha no es válida.")

    @staticmethod
    def _convertir_hora(valor):
        """Convierte una hora ISO a time."""
        if isinstance(valor, datetime):
            valor = valor.time()

        elif isinstance(valor, str):
            valor = time.fromisoformat(valor)

        if not isinstance(valor, time):
            raise ValueError("La hora no es válida.")

        if valor.tzinfo is not None:
            raise ValueError("La hora no debe incluir zona horaria.")

        return valor

    @staticmethod
    def crear_reserva(
        id_cliente,
        cantidad_personas,
        fecha,
        hora_inicio,
        hora_fin,
        observaciones=None,
        id_mesa=None,
    ):
        """
        Crea una reserva y bloquea una franja disponible
        para una mesa con capacidad suficiente.
        """
        try:
            fecha = ReservaRepositorio._convertir_fecha(fecha)
            hora_inicio = ReservaRepositorio._convertir_hora(
                hora_inicio
            )
            hora_fin = ReservaRepositorio._convertir_hora(
                hora_fin
            )

            if (
                not isinstance(cantidad_personas, int)
                or isinstance(cantidad_personas, bool)
                or cantidad_personas < 1
            ):
                return None

            if hora_inicio >= hora_fin:
                return None

            ahora = datetime.now()

            if fecha < ahora.date():
                return None

            if fecha == ahora.date() and hora_inicio <= ahora.time():
                return None

            cliente = ClienteDB.get_or_none(
                ClienteDB.id_cliente == id_cliente
            )

            if cliente is None:
                return None

            with database.atomic():
                consulta = (
                    Disponibilidad.select(Disponibilidad, Mesa)
                    .join(
                        Mesa,
                        on=(
                            Disponibilidad.id_mesa
                            == Mesa.id_mesa
                        ),
                    )
                    .where(
                        (Disponibilidad.fecha == fecha)
                        & (
                            Disponibilidad.hora_inicio
                            <= hora_inicio
                        )
                        & (
                            Disponibilidad.hora_fin
                            >= hora_fin
                        )
                        & (
                            Disponibilidad.estado_franja
                            == "Disponible"
                        )
                        & (Mesa.activa == True)
                        & (
                            Mesa.capacidad_comensales
                            >= cantidad_personas
                        )
                    )
                    .order_by(
                        Mesa.capacidad_comensales.asc(),
                        Mesa.id_mesa.asc(),
                    )
                    .for_update()
                )

                if id_mesa is not None:
                    consulta = consulta.where(
                        Mesa.id_mesa == id_mesa
                    )

                franja = consulta.first()

                if franja is None:
                    return None

                reserva = Reserva.create(
                    id_cliente=id_cliente,
                    cantidad_personas=cantidad_personas,
                    estado="Pendiente",
                    observaciones_especiales=observaciones,
                )

                franja.estado_franja = "Reservada"
                franja.id_reserva = reserva.id_reserva

                franja.save(
                    only=[
                        Disponibilidad.estado_franja,
                        Disponibilidad.id_reserva,
                    ]
                )

                return reserva

        except (TypeError, ValueError):
            return None

    @staticmethod
    def obtener_todas():
        """Obtiene todas las reservas, de la más reciente a la más antigua."""
        return list(
            Reserva.select().order_by(
                Reserva.id_reserva.desc()
            )
        )

    @staticmethod
    def obtener_todas_con_horario():
        """
        Obtiene reservas junto con cliente, correo,
        horario y número de mesa.
        """
        resultado = []

        for reserva in ReservaRepositorio.obtener_todas():
            cliente = ClienteDB.get_or_none(
                ClienteDB.id_cliente == reserva.id_cliente
            )

            nombre_cliente = "Cliente desconocido"
            correo_cliente = ""

            if cliente is not None:
                usuario = UsuarioDB.get_or_none(
                    UsuarioDB.id_usuario == cliente.id_usuario
                )

                if usuario is not None:
                    nombre_cliente = usuario.nombre_completo
                    correo_cliente = usuario.correo_electronico

            franjas = list(
                Disponibilidad.select().where(
                    Disponibilidad.id_reserva
                    == reserva.id_reserva
                )
            )

            datos_reserva = {
                "id_reserva": reserva.id_reserva,
                "nombre_cliente": nombre_cliente,
                "correo_cliente": correo_cliente,
                "cantidad_personas": reserva.cantidad_personas,
                "estado": reserva.estado,
                "observaciones": reserva.observaciones_especiales,
            }

            if not franjas:
                resultado.append({
                    **datos_reserva,
                    "fecha": None,
                    "hora_inicio": None,
                    "hora_fin": None,
                    "numero_mesa": "",
                })
                continue

            for franja in franjas:
                mesa = Mesa.get_or_none(
                    Mesa.id_mesa == franja.id_mesa
                )

                resultado.append({
                    **datos_reserva,
                    "fecha": franja.fecha,
                    "hora_inicio": franja.hora_inicio,
                    "hora_fin": franja.hora_fin,
                    "numero_mesa": (
                        mesa.numero_mesa
                        if mesa is not None
                        else ""
                    ),
                })

        return resultado

    @staticmethod
    def obtener_por_id(id_reserva):
        """Busca una reserva por su identificador."""
        try:
            return Reserva.get(
                Reserva.id_reserva == id_reserva
            )
        except DoesNotExist:
            return None

    @staticmethod
    def cambiar_estado(id_reserva, nuevo_estado):
        """
        Cambia el estado de una reserva.
        Cuando se cancela, libera la franja asociada.
        """
        if nuevo_estado not in ReservaRepositorio.ESTADOS_VALIDOS:
            return False

        try:
            with database.atomic():
                reserva = (
                    Reserva.select()
                    .where(
                        Reserva.id_reserva == id_reserva
                    )
                    .for_update()
                    .get()
                )

                estado_actual = reserva.estado

                permitidos = (
                    ReservaRepositorio.TRANSICIONES_PERMITIDAS.get(
                        estado_actual, set()
                    )
                )

                if nuevo_estado not in permitidos:
                    return False

                reserva.estado = nuevo_estado
                reserva.save(only=[Reserva.estado])

                if nuevo_estado == "Cancelada":
                    (
                        Disponibilidad.update(
                            estado_franja="Disponible",
                            id_reserva=None,
                        )
                        .where(
                            Disponibilidad.id_reserva
                            == reserva.id_reserva
                        )
                        .execute()
                    )

                return True

        except DoesNotExist:
            return False
